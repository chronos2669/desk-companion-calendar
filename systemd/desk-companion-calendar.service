[Unit]
Description=Fetch upcoming iCloud calendar events
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/desk-companion-calendar/python
ExecStart=%h/Documents/desk-companion-calendar/python/.venv/bin/python fetch_events.py

# Creates ~/.cache/desk-companion if absent and makes it writable inside
# the sandbox. ReadWritePaths only mounts a directory that already exists
CacheDirectory=desk-companion

PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=true
